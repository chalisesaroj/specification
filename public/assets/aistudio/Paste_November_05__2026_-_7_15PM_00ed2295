function clearSpecPaste(){$('#specPaste').value='';}
function parseSpecPaste(){
  const txt=$('#specPaste').value.trim();
  if(!txt)return alert('पेस्ट गर्नुहोस्');
  const parsed=[];let maxCols=specColumns.length;
  txt.split(/\r?\n/).forEach(l=>{
    if(!l.trim())return;
    let c=l.split('\t').map(x=>x.trim());
    if(!c.length)return;
    if(/^(s\.?\s*n\.?|क्र\.?सं\.?|sn)$/i.test(c[0])) return;
    if(/^\d+$/.test(c[0]) && c.length>1) c=c.slice(1);
    if(!c.length)return;
    const merged=[];let cur='';
    for(let i=0;i<c.length;i++){
      if(c[i]==='' && cur!==''){merged.push(cur);cur='';}
      else if(c[i]!==''){
        if(cur!==''){merged.push(cur);}
        cur=c[i];
      }
    }
    if(cur!=='') merged.push(cur);
    parsed.push(merged.length?merged:c);
    if(merged.length>maxCols) maxCols=merged.length;
  });
  if(!parsed.length)return alert('पार्स गर्न सकिएन।');
  while(specColumns.length<maxCols){specColumns.push('Column '+(specColumns.length+1));}
  specRows=parsed.map(c=>{
    const cells=c.slice();
    while(cells.length<specColumns.length) cells.push('');
    return {cells,params:[],reqText:''};
  });
  renderSpecRows();specPreviewRender();
}
