function billRows(d){
  const rows=[];
  const fromPlace=d.office||'';
  const n=d.days;
  const travelCost=d.isPrivate?'--':d.oneWay;
  if(n===1){
    rows.push({a:fromPlace,b:d.place,date:d.from,mode:d.mode,travel:travelCost,isPrivate:d.isPrivate,days:1,rate:d.rate,allow:d.rate});
  }else if(n===2){
    rows.push({a:fromPlace,b:d.place,date:d.from,mode:d.mode,travel:travelCost,isPrivate:d.isPrivate,days:1,rate:d.rate,allow:d.rate});
    rows.push({a:d.place,b:fromPlace,date:d.to,mode:d.mode,travel:travelCost,isPrivate:d.isPrivate,days:1,rate:d.rate,allow:d.rate});
  }else{
    rows.push({a:fromPlace,b:d.place,date:d.from,mode:d.mode,travel:travelCost,isPrivate:d.isPrivate,days:1,rate:d.rate,allow:d.rate});
    rows.push({mid:true,label:'मिति '+d.from+' देखि '+d.to+' सम्म '+d.purpose+' सम्बन्धी कार्य',days:n-2,rate:d.rate,allow:(n-2)*d.rate});
    rows.push({a:d.place,b:fromPlace,date:d.to,mode:d.mode,travel:travelCost,isPrivate:d.isPrivate,days:1,rate:d.rate,allow:d.rate});
  }
  return rows;
}
