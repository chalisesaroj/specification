function estPreview(){
  const title=$('#e_title').value,no=$('#e_no').value,dt=$('#e_date').value;
  const contP=num($('#e_cont').value),vatP=num($('#e_vat').value),vatOn=$('#e_vatOn').value==='yes';
  const remarks=$('#e_remarks').value;
  const vehType=$('#e_vehType').value.trim(),vehMake=$('#e_vehMake').value.trim(),vehYear=$('#e_vehYear').value.trim();
  const headerMode=$('#e_headerMode').value;

  let sub2=0;
  estRows.forEach(r=>sub2+=num(r.amount));
  const cont=sub2*contP/100;
  const base=sub2+cont;
  const vat=vatOn?base*vatP/100:0;
  const total=base+vat;

  let h=headerHTML(headerMode,'en');
  h+='<div class="doc">';
  h+=estOfficeBlockHTML();
  h+='<h2>'+esc(title)+'</h2>';

  const hasVehType=!!vehType;
  const hasVehMake=!!vehMake;
  const hasVehYear=!!vehYear;
  if(hasVehType||hasVehMake||hasVehYear){
    const colCount=[hasVehType,hasVehMake,hasVehYear].filter(Boolean).length;
    const pct=(100/colCount).toFixed(2);
    h+='<table class="spec" style="margin-bottom:6px"><tr>';
    if(hasVehType) h+='<th style="width:'+pct+'%">Vehicle Type</th>';
    if(hasVehMake) h+='<th style="width:'+pct+'%">Make / Model</th>';
    if(hasVehYear) h+='<th style="width:'+pct+'%">Manufacture Year</th>';
    h+='</tr><tr>';
    if(hasVehType) h+='<td style="text-align:center">'+esc(vehType)+'</td>';
    if(hasVehMake) h+='<td style="text-align:center">'+esc(vehMake)+'</td>';
    if(hasVehYear) h+='<td style="text-align:center">'+esc(vehYear)+'</td>';
    h+='</tr></table>';
  }

  h+='<table class="plain" style="margin-bottom:6px"><tr><td style="width:60%">'+(no?'Estimate No.: '+esc(no):'')+'</td><td style="text-align:right">'+(dt?'Date: '+esc(dt):'')+'</td></tr></table>';
  h+='<table class="spec"><tr><th style="width:6%">S.N.</th><th>Description</th><th style="width:10%">Unit</th><th style="width:10%">Qty</th><th style="width:14%">Rate (NRs.)</th><th style="width:16%">Amount (NRs.)</th></tr>';
  estRows.forEach((r,i)=>{
    h+='<tr><td style="text-align:center">'+(i+1)+'</td><td>'+esc(r.desc)+'</td><td style="text-align:center">'+esc(r.unit)+'</td><td style="text-align:center">'+esc(r.qty)+'</td><td style="text-align:right">'+fmt(r.rate)+'</td><td style="text-align:right">'+fmt(num(r.amount))+'</td></tr>';
  });
  h+='<tr><td colspan="5" style="text-align:right;font-weight:700">Sub Total</td><td style="text-align:right">'+fmt(sub2)+'</td></tr>';
  if(contP) h+='<tr><td colspan="5" style="text-align:right">Contingency @ '+contP+'%</td><td style="text-align:right">'+fmt(cont)+'</td></tr>';
  if(vatOn) h+='<tr><td colspan="5" style="text-align:right">VAT @ '+vatP+'%</td><td style="text-align:right">'+fmt(vat)+'</td></tr>';
  h+='<tr><td colspan="5" style="text-align:right;font-weight:700">Grand Total</td><td style="text-align:right;font-weight:700">'+fmt(total)+'</td></tr>';
  h+='</table>';
  h+='<p class="small" style="margin-top:5px"><b>In words:</b> '+amountWords(total)+'</p>';
  if(remarks) h+='<p class="small">'+esc(remarks)+'</p>';
  h+='<div class="sign">'+
     '<div><b>Prepared By</b><br><br>'+esc(S.prepName)+'<br>'+esc(S.prepDesig)+'<br>'+esc(S.nec)+'</div>'+
     '<div><b>Approved By</b><br><br>'+esc(S.appName||'..........................')+'<br>&nbsp;</div>'+
     '</div>';
  h+=footerHTML();
  h+='</div>';
  $('#e_preview').innerHTML=h;
}

