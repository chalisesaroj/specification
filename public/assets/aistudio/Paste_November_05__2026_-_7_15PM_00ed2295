<script>
/* ================= UTIL ================= */
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const NED='०१२३४५६७८९';
const ne=s=>String(s).replace(/\d/g,d=>NED[+d]);
const fmt=n=>{n=Number(n)||0;return n.toLocaleString('en-IN',{maximumFractionDigits:2});};
const fmtNe=n=>ne(fmt(n));
function num(v){
  if(typeof v==='number') return isNaN(v)?0:v;
  if(v==null||v===''||v==='—'||v==='-') return 0;
  const s=String(v).replace(/,/g,'');
  const m=s.match(/-?\d+(?:\.\d+)?/);
  return m?parseFloat(m[0]):0;
}
const O1=['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
const T1=['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
function w2(n){return n<20?O1[n]:T1[Math.floor(n/10)]+(n%10?' '+O1[n%10]:'');}
function w3(n){const h=Math.floor(n/100),r=n%100;return (h?O1[h]+' Hundred'+(r?' ':''):'')+(r?w2(r):'');}
function words(n){
  n=Math.round(Number(n)||0);
  if(n===0)return 'Zero';
  let out='';
  const cr=Math.floor(n/10000000); n%=10000000;
  const la=Math.floor(n/100000);   n%=100000;
  const th=Math.floor(n/1000);     n%=1000;
  if(cr) out+=(cr>99?words(cr):w3(cr))+' Crore ';
  if(la) out+=w2(la)+' Lakh ';
  if(th) out+=w2(th)+' Thousand ';
  if(n)  out+=w3(n);
  return out.trim();
}
const amountWords=n=>words(n)+' Rupees Only';
function printDoc(landscape){
