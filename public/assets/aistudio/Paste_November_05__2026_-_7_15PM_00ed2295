     '<th colspan="2">देखि</th><th colspan="2">सम्म</th><th colspan="2">भ्रमण</th><th colspan="3">दैनिक भत्ता</th><th colspan="2">फुटकर खर्च</th><th rowspan="2">कुल जम्मा</th></tr>'+
     '<tr><th>स्थान</th><th>मिति</th><th>स्थान</th><th>मिति</th><th>साधन</th><th>खर्च</th><th>दिन</th><th>दर</th><th>जम्मा</th><th>विवरण</th><th>जम्मा</th></tr>'+
     '<tr><td colspan="12" style="text-align:center;font-size:9pt">१&nbsp;&nbsp;२&nbsp;&nbsp;३&nbsp;&nbsp;४&nbsp;&nbsp;५&nbsp;&nbsp;६&nbsp;&nbsp;७&nbsp;&nbsp;८&nbsp;&nbsp;९&nbsp;&nbsp;१०&nbsp;&nbsp;११&nbsp;&nbsp;१२</td></tr>';
  rows.forEach(r=>{
    if(r.mid){
      h+='<tr><td colspan="4">'+esc(r.label)+'</td><td></td><td></td><td style="text-align:center">'+ne(r.days)+'</td><td style="text-align:right">'+fmtNe(r.rate)+'</td><td style="text-align:right">'+fmtNe(r.allow)+'</td><td>--</td><td style="text-align:right">०</td><td style="text-align:right">'+fmtNe(r.allow)+'</td></tr>';
    }else{
      const travelDisplay=fmtTravel(r.travel);
      const rowTotal=(r.travel==='--'?0:num(r.travel))+num(r.allow);
      h+='<tr><td>'+esc(r.a)+'</td><td>'+esc(r.date)+'</td><td>'+esc(r.b)+'</td><td>'+esc(r.date)+'</td><td>'+esc(r.mode)+'</td><td style="text-align:right">'+travelDisplay+'</td><td style="text-align:center">'+ne(r.days)+'</td><td style="text-align:right">'+fmtNe(r.rate)+'</td><td style="text-align:right">'+fmtNe(r.allow)+'</td><td>--</td><td style="text-align:right">०</td><td style="text-align:right">'+fmtNe(rowTotal)+'</td></tr>';
    }
  });
  h+='<tr><td colspan="5" style="text-align:right"><b>जम्मा</b></td><td style="text-align:right">'+fmtNe(travelTot)+'</td><td></td><td></td><td style="text-align:right">'+fmtNe(allowTot)+'</td><td></td><td style="text-align:right">'+fmtNe(misc)+'</td><td style="text-align:right"><b>'+fmtNe(grand)+'</b></td></tr>';
  h+='</table>';
  h+='<table style="margin-top:8px;width:56%;font-size:10pt" class="box">'+
     '<tr><td>१. भ्रमण खर्च (महल ६ को जम्मा रु.)</td><td style="text-align:right">'+fmtNe(travelTot)+'</td></tr>'+
     '<tr><td>२. दैनिक भत्ता (महल ९ को जम्मा रु.)</td><td style="text-align:right">'+fmtNe(allowTot)+'</td></tr>'+
     '<tr><td>४. फुटकर खर्च (महल ११ को जम्मा रु.)</td><td style="text-align:right">'+fmtNe(misc)+'</td></tr>'+
     '<tr><td>५. कुल जम्मा (महल १२ को जम्मा रु.)</td><td style="text-align:right">'+fmtNe(grand)+'</td></tr>'+
     '<tr><td>६. भ्रमण पेश्की रु.</td><td style="text-align:right">'+fmtNe(d.advance)+'</td></tr>'+
     '<tr><td>७. खुद भुक्तानी पाउने रकम रु.</td><td style="text-align:right">'+fmtNe(grand-d.advance)+'</td></tr>'+
     '</table>';
  h+='<table class="plain" style="margin-top:10px;font-size:10pt">'+
     '<tr><td>स्वीकृत भ्रमण आदेश नं. '+esc(d.toNo)+'</td><td style="text-align:right">मिति '+esc(d.toDate||d.from)+'</td></tr></table>';
  h+='<div style="font-size:10pt;margin-top:6px">पेश भएको व्यहोरा ठीक छ, झुट्टा ठहरे प्रचलित कानुन बमोजिम सहुँला/बुझाउँला छु।<br>भ्रमण गर्ने कर्मचारीको दस्तखतः ..........................  मितिः ............</div>';
  h+='<div class="sign" style="margin-top:26px;font-size:10pt">'+
     '<div>जाँच गर्ने अधिकारीको दस्तखतः<br>..........................<br>मितिः</div>'+
     '<div><b>स्वीकृत रकम: '+fmtNe(grand-d.advance)+'</b></div>'+
     '<div>स्वीकृत गर्ने अधिकारीको दस्तखतः<br>..........................<br>मितिः</div></div>';
  h+=footerHTML();
  h+='</div>';
  return h;
}
function reportDescriptions(d){
  const n=d.days;const arr=[];
  for(let i=0;i<n;i++){
    if(i===0) arr.push((d.office||'कार्यालय')+' बाट '+d.place+' प्रस्थान गरी सम्बन्धित कार्यालयमा सम्पर्क तथा कार्यक्रमको प्रारम्भिक जानकारी लिइयो।');
    else if(i===n-1) arr.push('सम्पन्न कार्यबारे जानकारी गराई '+d.place+' बाट फिर्ता भइयो।');
    else arr.push(d.purpose+' सम्बन्धी कार्य सम्पन्न गरियो।');
  }
  return arr;
}
function renderReport(d){
  const descs=reportDescriptions(d);
  const dates=[];
  for(let i=0;i<d.days;i++){
    if(d.dateList[i]) dates[i]=d.dateList[i];
    else if(i===0) dates[i]=d.from;
    else if(i===d.days-1) dates[i]=d.to;
    else dates[i]='................';
  }
  let h='';
  if($('#t_letterhead').checked) h+=letterheadHTML('ne');
  h+='<div class="doc">';
  h+='<div style="text-align:right;font-size:10pt">म.ले.प.फारम नं : ९०९<br>मिति: '+esc(d.to)+'</div>';
  h+='<h2>भ्रमण प्रतिवेदन</h2>';
  h+='<table class="plain" style="font-size:11pt">'+
     '<tr><td style="width:35%"><b>भ्रमण गर्ने कर्मचारीको नाम:</b></td><td>'+esc(d.name)+'</td></tr>'+
     '<tr><td><b>पद:</b></td><td>'+esc(d.desig)+'</td></tr>'+
     '<tr><td><b>कार्यालय:</b></td><td>'+esc(d.office)+'</td></tr>'+
     '<tr><td><b>भ्रमण स्थान:</b></td><td>'+esc(d.place)+'</td></tr>'+
     '<tr><td><b>भ्रमण अवधि:</b></td><td>'+esc(d.from)+' देखि '+esc(d.to)+' सम्म (कुल '+ne(d.days)+' दिन)</td></tr>'+
     '<tr><td><b>भ्रमणको उद्देश्य:</b></td><td>'+esc(d.purpose)+'</td></tr></table>';
  h+='<table class="box" style="margin-top:10px"><tr><th style="width:22%">मिति</th><th>सम्पन्न गरिएको कार्य विवरण</th></tr>';
  for(let i=0;i<d.days;i++){h+='<tr><td style="text-align:center">'+esc(dates[i])+'</td><td>'+esc(descs[i])+'</td></tr>';}
  h+='</table>';
  h+='<p style="text-align:justify;margin-top:12px;font-size:11pt">उपरोक्त अवधिमा '+esc(d.place)+' मा '+esc(d.purpose)+' सम्बन्धी कार्य सम्पन्न गरियो। सो कार्यका क्रममा आवश्यक छलफल, मस्यौदा तयारी, प्रस्तुतीकरण तथा अन्तिम मस्यौदा पेश गर्ने कार्य सम्पन्न भएको व्यहोरा जानकारी गराउँदछु।</p>';
  h+='<div class="sign" style="margin-top:40px"><div></div><div><b>प्रतिवेदक</b><br><br>..........................<br>'+esc(d.name)+'<br>'+esc(d.desig)+'</div></div>';
  h+=footerHTML();
  h+='</div>';
  return h;
}
function renderPayment(d){
  const addressee=S.tgtNameNe||S.org1;
  const addresseeAddr=S.tgtAddrNe||'';
  const travelPlace=d.place||addressee;
  let h='';
  if($('#t_letterhead').checked) h+=letterheadHTML('ne');
  h+='<div class="doc">';
  h+='<div style="text-align:right;font-size:10pt">मिति: '+esc(d.to)+'</div>';
  h+='<div style="margin-top:26px;font-size:11pt">श्रीमान् नगर प्रमुख ज्यु,<br>'+esc(addressee)+(addresseeAddr?'<br>'+esc(addresseeAddr):'')+'</div>';
  h+='<div class="center" style="margin:14px 0 10px"><b>विषय : भुक्तानी पाउँ भन्ने सम्बन्धमा</b></div>';
  h+='<p style="text-align:justify;font-size:11pt">प्रस्तुत विषयमा, '+esc(d.office)+' को '+esc(d.purpose)+' का निमित्त म मिति '+esc(d.from)+' देखि '+esc(d.to)+' सम्म '+esc(travelPlace)+' गई पुनः फर्किएको कुरा जानकारी गराउँदै सोको भ्रमण आदेश र भ्रमण बिल यसै निवेदनसाथ पेश गरेको छु। पेश भएको भ्रमण बिल बमोजिमको खर्च तपशिल बमोजिमको बैंक खातामा भुक्तानी गराइदिनुहुन श्रीमान् समक्ष अनुरोध गर्दछु।</p>';
  h+='<div style="margin-top:12px;font-size:11pt"><b>तपशिल</b><br>'+
     'A/C Holder Name: '+esc(S.bankHolder)+'<br>'+
     'Account Number: '+esc(S.bankAcc)+'<br>'+
     'Bank Name: '+esc(S.bankName)+'<br>'+
     'Branch Name: '+esc(S.bankBranch)+'</div>';
  h+='<div class="sign" style="margin-top:56px"><div></div><div><b>निवेदक</b><br><br>..........................<br>'+esc(d.name)+'<br>'+esc(d.desig)+'<br>'+esc(d.office)+'</div></div>';
  h+=footerHTML();
  h+='</div>';
  return h;
}
function initTO(){
  $('#t_name').value=S.prepName;
  $('#t_desig').value=S.prepDesig;
  $('#t_office').value=S.org1+', '+S.org4;
  $('#t_address').value=S.org1;
  $('#t_payOffice').value=S.org1+', '+S.org4;
  $('#t_place').value=S.tgtNameNe||'';
  $('#t_purpose').value='सवारी खरिद सम्बन्धी आवश्यक कार्यहरू';
  $('#t_mode').value='ट्याक्सी';
  attachNpDatePicker($('#t_from'));
  attachNpDatePicker($('#t_to'));
  attachNpDatePicker($('#t_toDate'));
  toRenderAll();
}

