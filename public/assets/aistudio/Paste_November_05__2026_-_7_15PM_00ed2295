function estParse(){
  const txt=$('#e_paste').value.trim();
  if(!txt)return alert('पेस्ट गर्नुहोस्');
  const out=[];
  txt.split(/\r?\n/).forEach(l=>{
    if(!l.trim())return;
    const c=l.split('\t').map(x=>x.trim());
    if(c.length<2)return;
    if(/^(s\.?\s*n\.?|क्र\.?सं\.?|sn)$/i.test(c[0]) && /desc|particular|विवरण|item|वस्तु/i.test(c[1]||'')) return;
    let desc='',unit='Nos.',qty=1,rate=0,amount=null;
    let cells=c.slice();
    if(/^\d+$/.test(cells[0]) && cells.length>2){ cells=cells.slice(1); }
    if(cells.length>=5){
      desc=cells[0]; unit=cells[1]||'Nos.';
      qty=num(cells[2]); rate=num(cells[3]); amount=num(cells[4]);
    } else if(cells.length===4){
      const c2=cells[2], c3=cells[3];
      if(isNaN(parseFloat(String(cells[1]))) && !isNaN(parseFloat(String(c2)))){
        desc=cells[0]; unit=cells[1]||'Nos.'; qty=num(c2); rate=num(c3);
      } else {
        desc=cells[0]; qty=num(cells[1]); rate=num(c2); amount=num(c3);
      }
    } else if(cells.length===3){
      desc=cells[0];
      if(isNaN(parseFloat(String(cells[1])))){ unit=cells[1]; rate=num(cells[2]); }
      else { qty=num(cells[1]); rate=num(cells[2]); }
    } else { desc=cells[0]; rate=num(cells[1]); }
    if(!desc) return;
    if(amount==null||isNaN(amount)||(amount===0 && (qty*rate)>0)) amount=qty*rate;
    out.push({desc,unit,qty,rate,amount});
  });
