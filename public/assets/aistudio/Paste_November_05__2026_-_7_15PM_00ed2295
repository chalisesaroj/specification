<!DOCTYPE html>
<html lang="ne">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>प्राविधिक कागजात स्वचालित निर्माण प्रणाली</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:'Noto Sans Devanagari',system-ui,-apple-system,sans-serif;background:#eef1f5;color:#14202b;font-size:14px}
.appbar{position:sticky;top:0;z-index:50;background:#0b4a34;color:#fff;padding:8px 14px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;box-shadow:0 2px 8px rgba(0,0,0,.15)}
.appbar h1{font-size:15px;margin:0;font-weight:600}
.tabs{display:flex;gap:4px;flex-wrap:wrap;margin-left:auto}
.tabs button{background:rgba(255,255,255,.14);color:#fff;border:0;padding:6px 11px;border-radius:6px;font:inherit;font-size:13px;cursor:pointer}
.tabs button.on{background:#fff;color:#0b4a34;font-weight:600}
.module{display:none}
.module.active{display:block}
.layout{display:grid;grid-template-columns:440px 1fr;gap:14px;padding:14px;align-items:start}
@media(max-width:1050px){.layout{grid-template-columns:1fr}}
.card{background:#fff;border:1px solid #d5dde5;border-radius:10px;padding:12px;margin-bottom:12px}
.card h3{margin:0 0 8px;font-size:14px;color:#0b4a34}
label{display:block;font-size:12px;font-weight:600;color:#3a4a58;margin:6px 0 3px}
input,select,textarea{width:100%;padding:6px 8px;border:1px solid #c5cfda;border-radius:6px;font:inherit;font-size:13px;background:#fff;color:#14202b}
textarea{resize:vertical}
.btn{background:#0b4a34;color:#fff;border:0;padding:8px 14px;border-radius:7px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.btn.alt{background:#e8edf2;color:#22303c}
.btn.sm{padding:5px 10px;font-size:12px}
.mini{padding:2px 7px;font-size:12px;border-radius:5px;border:1px solid #c5cfda;background:#fff;cursor:pointer}
.mini.danger{color:#a5281f;border-color:#e3b4b0}
.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
table.grid{width:100%;border-collapse:collapse;font-size:12px;margin-top:6px}
table.grid th{background:#eef3f7;border:1px solid #cfd8e1;padding:4px 5px;text-align:left;font-size:11.5px}
table.grid td{border:1px solid #cfd8e1;padding:3px 4px;vertical-align:top}
table.grid input,table.grid textarea,table.grid select{font-size:12px;padding:3px 5px;border-radius:4px}
.preview{background:#fff;border:1px solid #d5dde5;border-radius:8px;padding:18px 20px;min-height:500px;overflow:auto}
.hint{font-size:11.5px;color:#657687;margin-top:4px;line-height:1.4}
.thumb{width:120px;border:1px solid #cfd8e1;border-radius:6px;padding:4px;background:#fff;display:inline-block;margin:4px;vertical-align:top}
.thumb img{width:100%;display:block;border-radius:4px}
.flexrow{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.subtabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.subtabs button{background:#e8edf2;border:0;padding:6px 12px;border-radius:20px;font:inherit;font-size:12.5px;cursor:pointer;color:#22303c}
.subtabs button.on{background:#0b4a34;color:#fff;font-weight:600}
/* ---------- document styles ---------- */
.doc{font-family:'Noto Serif Devanagari',serif;color:#000;font-size:12pt;line-height:1.5}
.doc table{border-collapse:collapse;width:100%}
.doc table.spec th,.doc table.spec td{border:1px solid #000;padding:4px 6px;vertical-align:top;font-size:10pt}
.doc table.spec th{background:#f0f0f0;text-align:center;font-weight:700}
.doc table.plain td{border:0;padding:2px 0;font-size:11pt;vertical-align:top}
.doc h2{font-size:13pt;text-align:center;margin:8px 0 10px;font-weight:700}
.doc h3{font-size:11.5pt;margin:10px 0 6px;font-weight:700}
.doc .lh{margin-bottom:8px}
.doc .lh .line{border-bottom:2px solid #000;margin-top:4px}
.doc .sign{margin-top:30px;display:flex;justify-content:space-between;gap:20px}
.doc .sign div{text-align:center;font-size:10.5pt;line-height:1.6}
.doc .ftr{margin-top:26px;border-top:1px solid #888;padding-top:4px;font-size:9pt;color:#333;text-align:center}
.doc .center{text-align:center}
.doc .small{font-size:10pt}
.doc table.box th,.doc table.box td{border:1px solid #000;padding:4px 5px;font-size:10pt;vertical-align:top}
.doc table.box th{background:#f0f0f0;text-align:center}
.doc ul{margin:4px 0 0 18px;padding:0}
.doc ul li{font-size:10pt;margin-bottom:3px}
.photo-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
.photo-grid figure{width:46%;margin:0;border:1px solid #999;padding:4px}
.photo-grid img{width:100%;display:block}
.photo-grid figcaption{font-size:9pt;text-align:center;margin-top:3px}
.office-title{text-align:center;margin:6px 0 12px}
.office-title .parent{font-size:12pt;font-weight:600}
.office-title .child{font-size:16pt;font-weight:700}
.office-title .loc{font-size:11pt}
/* ---------- modal ---------- */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;z-index:200;padding:18px;overflow:auto}
.modal-overlay.on{display:block}
.modal{background:#fff;max-width:720px;margin:30px auto;border-radius:12px;padding:16px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
.modal h3{margin:0 0 10px}
.param-row{display:grid;grid-template-columns:1.6fr 1.3fr 1fr 0.7fr 32px;gap:6px;margin-bottom:6px;align-items:center}
/* ---------- Nepali date picker ---------- */
.np-picker-popup{position:fixed;background:#fff;border:1px solid #b7c3cf;border-radius:9px;padding:8px;box-shadow:0 8px 24px rgba(0,0,0,.18);z-index:1500;width:280px}
.np-picker-header{display:flex;align-items:center;gap:4px;margin-bottom:6px}
.np-picker-header select{padding:3px 4px;font-size:12px}
.np-picker-header button{background:#e8edf2;border:1px solid #c5cfda;border-radius:5px;padding:3px 7px;cursor:pointer;font-weight:600}
.np-picker-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.np-picker-day{text-align:center;padding:5px 0;border-radius:5px;cursor:pointer;font-size:12.5px}
.np-picker-day:hover{background:#e8f3ec}
.np-picker-day.today{background:#cce5d5;font-weight:700}
.np-picker-day.head{color:#0b4a34;font-weight:700;cursor:default;font-size:11px}
.np-picker-day.head:hover{background:transparent}
@media print{
  body{background:#fff}
  .no-print,.appbar,.modal-overlay{display:none!important}
  .module{display:none!important}
  .module.active{display:block!important}
  .layout{display:block!important;padding:0!important;gap:0!important}
  .preview{border:0!important;padding:0!important;min-height:0!important;overflow:visible!important;border-radius:0!important}
  .preview.hidden{display:none!important}
  .doc{font-size:11pt}
  .doc table.spec th,.doc table.spec td{font-size:9.5pt}
  .doc .sign{margin-top:22px}
  .page-break{page-break-after:always}
}
</style>
<style id="pageStyle">@page{size:A4 portrait;margin:12mm}</style>
</head>
<body>

<div class="appbar no-print">
  <h1>⚙️ प्राविधिक कागजात स्वचालित निर्माण प्रणाली</h1>
  <div class="tabs">
    <button data-tab="settings" class="on" onclick="showTab('settings')">सेटिङ</button>
    <button data-tab="spec" onclick="showTab('spec')">स्पेसिफिकेसन</button>
    <button data-tab="insp" onclick="showTab('insp')">इन्स्पेक्सन रिपोर्ट</button>
    <button data-tab="est" onclick="showTab('est')">मर्मत अनुमान</button>
    <button data-tab="letter" onclick="showTab('letter')">पत्र</button>
    <button data-tab="to" onclick="showTab('to')">भ्रमण आदेश / बिल</button>
  </div>
</div>

<!-- ============ SETTINGS ============ -->
<section id="mod-settings" class="module active">
  <div class="layout">
    <div class="no-print">
      <div class="card">
        <h3>लेटरहेड (नेपाली) — आफ्नो कार्यालय</h3>
        <label>पहिलो लाइन</label><input id="s_org1">
        <label>दोस्रो लाइन</label><input id="s_org2">
        <label>तेस्रो लाइन</label><input id="s_org3">
        <label>चौथो लाइन (शिक्षालय)</label><input id="s_org4">
        <label>पाँचौं लाइन</label><input id="s_org5">
      </div>
      <div class="card">
        <h3>लेटरहेड (English)</h3>
        <label>Line 1</label><input id="s_eng1">
        <label>Line 2</label><input id="s_eng2">
        <label>Line 3</label><input id="s_eng3">
        <label>Line 4</label><input id="s_eng4">
      </div>
      <div class="card">
        <h3>गन्तव्य कार्यालय (Specification / पत्र / भ्रमण)</h3>
        <div class="hint">तलको सूचीबाट कार्यालय छान्नुहोस् — नाम र ठेगाना स्वतः भरिनेछ। आवश्यक परे तलका बक्सहरूमा म्यानुअल रूपमा पनि सम्पादन गर्न सकिन्छ।</div>
        <label>🔍 कार्यालय खोज्नुहोस् (फिल्टर)</label>
        <input id="s_tgtFilter" placeholder="जस्तै: पोखरा, पुतली, भीरकोट..." oninput="officeFilterChange()">
        <label>कार्यालय छान्नुहोस्</label>
        <select id="s_tgtSelect" onchange="onTargetOfficeSelect()"></select>
        <label>कार्यालयको नाम (नेपाली)</label><input id="s_tgtNameNe">
        <label>ठेगाना (नेपाली)</label><input id="s_tgtAddrNe">
        <label>Office Name (English)</label><input id="s_tgtNameEn">
        <label>Address (English)</label><input id="s_tgtAddrEn">
        <button class="btn alt sm" style="margin-top:8px" onclick="clearTargetOffice()">🗑 गन्तव्य खाली गर्नुहोस्</button>
      </div>
      <div class="card">
        <h3>सम्पर्क तथा फुटर</h3>
        <div class="row3">
          <div><label>वेबसाइट</label><input id="s_website"></div>
          <div><label>इमेल</label><input id="s_email"></div>
          <div><label>फोन</label><input id="s_phone"></div>
        </div>
        <label>फुटर (खाली छोड्नुभए कुनै फुटर देखिने छैन)</label><input id="s_footer">
      </div>
      <div class="card">
        <h3>लोगो</h3>
        <div class="row">
          <div><label>बायाँ लोगो</label><input type="file" id="s_logoLeft" accept="image/*"></div>
          <div><label>दायाँ लोगो</label><input type="file" id="s_logoRight" accept="image/*"></div>
        </div>
        <div id="logoPreview" style="margin-top:8px"></div>
        <button class="mini danger" onclick="clearLogo('left')">बायाँ हटाउने</button>
        <button class="mini danger" onclick="clearLogo('right')">दायाँ हटाउने</button>
      </div>
      <div class="card">
        <h3>हस्ताक्षरकर्ता / बैंक</h3>
        <label>तयार गर्नेको नाम</label><input id="s_prepName">
        <label>पद</label><input id="s_prepDesig">
        <label>NEC / दर्ता विवरण</label><input id="s_nec">
        <label>स्वीकृत गर्नेको नाम</label><input id="s_appName">
        <div class="row3">
          <div><label>A/C Holder</label><input id="s_bankHolder"></div>
          <div><label>Account No.</label><input id="s_bankAcc"></div>
          <div><label>Bank</label><input id="s_bankName"></div>
        </div>
        <label>Branch</label><input id="s_bankBranch">
      </div>
      <button class="btn" onclick="saveSettingsForm()">💾 सेभ गर्नुहोस्</button>
      <span id="saveMsg" style="color:#0b4a34;font-weight:600;margin-left:8px"></span>
    </div>
    <div>
      <div class="card">
        <h3>निर्देशन</h3>
        <div class="hint">
          १. कार्यालयको नाम, लोगो, सम्पर्क र हस्ताक्षरकर्ता भर्नुहोस्।<br>
          २. <b>गन्तव्य कार्यालय</b> सूचीबाट छान्नुहोस् — नाम, ठेगाना (नेपाली र English दुवै) स्वतः भरिन्छ। आवश्यक परे म्यानुअल सम्पादन गर्न सकिन्छ।<br>
          ३. फुटर खाली राख्नुभए कुनै फुटर देखिने छैन।<br>
          ४. मिति भर्न क्लिक गर्नुहोस् — नेपाली पात्रो खुल्नेछ।
        </div>
      </div>
      <div class="card"><h3>पूर्वावलोकन (लेटरहेड)</h3><div class="preview" id="settingsPreview"></div></div>
    </div>
  </div>
</section>

<!-- ============ SPECIFICATION ============ -->
<section id="mod-spec" class="module">
  <div class="layout">
    <div class="no-print">
      <div class="card">
        <h3>१. किसिम तथा विवरण</h3>
        <label>सवारी / मेसिनको प्रकार</label>
        <select id="specType" onchange="onSpecTypeChange()"></select>
        <button class="btn sm" style="margin-top:8px" onclick="loadSpecTemplate()">🔄 टेम्प्लेट लोड गर्नुहोस्</button>
        <label>कागजातको शीर्षक</label><input id="specTitle" oninput="specPreviewRender()">
        <div class="row3" style="margin-top:6px">
          <div><label>Make</label><input id="specMake" oninput="specPreviewRender()"></div>
          <div><label>Model</label><input id="specModel" oninput="specPreviewRender()"></div>
          <div><label>Country of Origin</label><input id="specCountry" oninput="specPreviewRender()"></div>
        </div>
      </div>

      <div class="card">
        <h3>२. प्राविधिक स्पेसिफिकेसन</h3>
        <div class="hint">प्रत्येक पङ्क्तिको <b>🔧</b> बटनले मापदण्ड बनाउन मिल्ने विन्डो खोल्छ।</div>
        <button class="btn alt sm" style="margin-top:6px" onclick="addSpecColumn()">+ नयाँ स्तम्भ</button>
        <div style="overflow-x:auto;margin-top:8px">
          <table class="grid" id="specRowsTable"></table>
        </div>
        <button class="btn alt sm" style="margin-top:8px" onclick="addSpecRow()">+ नयाँ पङ्क्ति</button>
        <textarea id="specPaste" rows="3" placeholder="Criteria&#9;Requirement"></textarea>
        <div class="flexrow" style="margin-top:6px">
          <button class="btn alt sm" onclick="parseSpecPaste()">📋 पार्स गर्नुहोस्</button>
          <button class="btn alt sm" onclick="clearSpecPaste()">🗑 खाली गर्नुहोस्</button>
        </div>
      </div>

      <div class="card">
        <h3>३. लागत अनुमान</h3>
        <div class="row3">
          <div><label>परिमाण</label><input id="specQty" type="number" value="1" oninput="specPreviewRender()"></div>
          <div><label>एकाइ</label><input id="specUnit" value="Nos." oninput="specPreviewRender()"></div>
          <div><label>दर (रु.)</label><input id="specRate" type="number" value="0" oninput="specPreviewRender()"></div>
        </div>
        <label style="margin-top:8px"><input type="checkbox" id="specVatOn" onchange="specPreviewRender()" style="width:auto"> VAT लागू</label>
        <div class="row">
          <div><label>VAT दर (%)</label><input id="specVatRate" type="number" value="13" oninput="specPreviewRender()"></div>
          <div><label>Remarks</label><input id="specRemarks" value="As per the market survey and website research of authorized dealers of Nepal" oninput="specPreviewRender()"></div>
        </div>
        <label>Delivery (कहाँ पुर्‍याउने)</label><input id="specDelivery" oninput="specPreviewRender()">
      </div>

      <div class="card">
        <h3>हेडर व्यवस्थापन</h3>
        <label>हेडर</label>
        <select id="specHeaderMode" onchange="specPreviewRender()">
          <option value="own">आफ्नो कार्यालयको लेटरहेड</option>
          <option value="target">गन्तव्य कार्यालय (सेटिङमा भरिएको)</option>
          <option value="none">कुनै हेडर नदेखाउने</option>
        </select>
      </div>

      <div class="card">
        <div class="subtabs" id="specTabs">
          <button data-v="spec" class="on" onclick="specShow('spec')">स्पेसिफिकेसन</button>
          <button data-v="est" onclick="specShow('est')">लागत अनुमान</button>
        </div>
        <button class="btn" onclick="specPreviewRender()">👁 पूर्वावलोकन</button>
        <button class="btn alt" onclick="printDoc(false)">🖨 Print / PDF</button>
      </div>
    </div>
    <div>
      <div class="preview" id="specPreview"></div>
      <div class="preview hidden" id="specEstPreview"></div>
    </div>
  </div>
</section>

<!-- ============ INSPECTION ============ -->
<section id="mod-insp" class="module">
  <div class="layout">
    <div class="no-print">
      <div class="card">
        <h3>१. कागजातको शीर्षक</h3>
        <label>Title</label><input id="i_title" value="Inspection Report of Vehicle" oninput="inspPreview()">
        <label>माथिको उप-शीर्षक</label><input id="i_subtitle" placeholder="Urban Resilience and Livability Improvement Project ..." oninput="inspPreview()">
      </div>

      <div class="card">
        <h3>हेडर व्यवस्थापन</h3>
        <label>हेडर</label>
        <select id="i_headerMode" onchange="inspPreview()">
          <option value="own">आफ्नो कार्यालयको लेटरहेड</option>
          <option value="target">गन्तव्य कार्यालय (सेटिङमा भरिएको)</option>
          <option value="none">कुनै हेडर नदेखाउने</option>
        </select>
      </div>

      <div class="card">
        <h3>२. सवारी / मेसिनको विवरण</h3>
        <table class="grid" id="i_details"></table>
        <button class="btn alt sm" style="margin-top:6px" onclick="inspAddDetail()">+ थप्नुहोस्</button>
      </div>

      <div class="card">
        <h3>३. स्पेसिफिकेसन अनुरूपता</h3>
        <div class="hint">Word बाट स्वीकृत स्पेसिफिकेसनको टेबल (S.N | Criteria | Requirement) कपि गरी पेस्ट गर्नुहोस्।</div>
        <textarea id="i_paste" rows="5" placeholder="1&#9;General&#9;Four door, Right Hand Drive ..."></textarea>
        <div class="flexrow" style="margin-top:6px">
          <button class="btn sm" onclick="inspParse()">📋 पार्स गर्नुहोस्</button>
          <button class="btn alt sm" onclick="inspClearSpec()">🗑 खाली गर्नुहोस्</button>
        </div>
        <div style="max-height:420px;overflow:auto;margin-top:8px">
          <table class="grid" id="i_spec"></table>
        </div>
      </div>

      <div class="card">
        <h3>४. कार्यक्षमता जाँच</h3>
        <table class="grid" id="i_func"></table>
        <button class="btn alt sm" style="margin-top:6px" onclick="inspAddFunc()">+ थप्नुहोस्</button>
      </div>

      <div class="card">
        <h3>५. फोटोग्राफ</h3>
        <input type="file" id="i_photos" accept="image/*" multiple onchange="inspAddPhotos(event)">
        <div id="i_photoList" style="margin-top:6px"></div>
      </div>

      <div class="card">
        <h3>६. निष्कर्ष तथा हस्ताक्षर</h3>
        <label>निष्कर्ष</label>
        <textarea id="i_conclusion" rows="3" oninput="inspPreview()">Upon inspection it was found that the supplied vehicle complies fully as per the approved specification of the office. Hence it is recommended for further proceedings.</textarea>
        <div class="row">
          <div><label>Prepared by (नाम)</label><input id="i_prep" oninput="inspPreview()"></div>
          <div><label>Approved by (नाम)</label><input id="i_app" oninput="inspPreview()"></div>
        </div>
        <label>जाँच मिति</label><input id="i_date" oninput="inspPreview()">
      </div>

      <div class="card">
        <button class="btn" onclick="inspPreview()">👁 पूर्वावलोकन</button>
