function initOfficeSelect(){
  const sel=$('#s_tgtSelect');
  if(!sel) return;
  renderOfficeSelect();
  // Match current value
  const cur=S.tgtNameNe;
  if(cur){
    const idx=OFFICE_LIST.findIndex(o=>o.ne===cur);
    if(idx>=0) sel.value=String(idx);
    else sel.value='__custom';
  }
}
function renderOfficeSelect(){
  const sel=$('#s_tgtSelect');
  if(!sel) return;
  const q=($('#s_tgtFilter').value||'').trim().toLowerCase();
  const groups={};
  OFFICE_LIST.forEach((o,i)=>{
    if(q){
      const hay=(o.ne+' '+(o.en||'')+' '+(o.addrNe||'')).toLowerCase();
      if(!hay.includes(q)) return;
    }
    const p=o.province||'अन्य';
    (groups[p]=groups[p]||[]).push({o,i});
  });
  let html='<option value="">-- छान्नुहोस् --</option>';
  for(const p in groups){
    html+='<optgroup label="'+esc(p)+'">';
    groups[p].forEach(({o,i})=>{
      html+='<option value="'+i+'">'+esc(o.ne)+' — '+esc(o.addrNe)+'</option>';
    });
    html+='</optgroup>';
  }
  html+='<option value="__custom">✏️ अन्य (आफैं टाइप गर्नुहोस्)</option>';
  sel.innerHTML=html;
}
function officeFilterChange(){ renderOfficeSelect(); }
function onTargetOfficeSelect(){
  const v=$('#s_tgtSelect').value;
  if(v==='' || v==='__custom') return;
  const o=OFFICE_LIST[+v];
  if(!o) return;
  $('#s_tgtNameNe').value=o.ne;
  $('#s_tgtAddrNe').value=o.addrNe;
  $('#s_tgtNameEn').value=o.en;
  $('#s_tgtAddrEn').value=o.addrEn;
  // Auto-save + refresh previews
  saveSettingsForm();
}
function clearTargetOffice(){
  $('#s_tgtSelect').value='';
  $('#s_tgtNameNe').value='';
  $('#s_tgtAddrNe').value='';
  $('#s_tgtNameEn').value='';
  $('#s_tgtAddrEn').value='';
  saveSettingsForm();
}

/* ================= NEPALI DATE PICKER ================= */
const NP_MONTHS=['बैशाख','जेठ','असार','साउन','भदौ','असोज','कार्तिक','मंसिर','पुष','माघ','फागुन','चैत'];
const NP_DAYS_SHORT=['आ','सो','मं','बु','बि','शु','श'];
const NP_DATA={
  2075:[31,32,31,32,31,30,30,30,29,29,30,30],2076:[31,32,31,32,31,30,30,30,29,30,29,31],
  2077:[31,32,31,32,31,30,30,30,29,30,29,31],2078:[31,31,32,31,31,31,30,29,30,29,30,30],
  2079:[31,32,31,32,31,30,30,30,29,30,29,31],2080:[31,32,31,32,31,30,30,30,29,30,29,31],
  2081:[31,31,32,31,31,31,30,29,30,29,30,30],2082:[30,32,31,32,31,30,30,30,29,30,29,31],
  2083:[31,31,32,31,31,31,30,29,30,29,30,30],2084:[31,31,32,31,31,30,30,30,29,30,29,31],
  2085:[31,32,31,32,30,31,30,30,29,30,29,31],2086:[31,31,32,31,31,31,30,29,30,29,30,30],
  2087:[31,31,32,31,31,30,30,30,29,30,29,31],2088:[31,32,31,32,31,30,30,30,29,30,29,31],
  2089:[30,32,31,32,31,30,30,30,29,30,29,31],2090:[31,31,32,31,31,31,30,29,30,29,30,30]
};
const NP_REF_BS={y:2081,m:1,d:1};
const NP_REF_AD=new Date(2024,3,13);
function bsToAdDays(bsy,bsm,bsd){
  if(bsy>NP_REF_BS.y || (bsy===NP_REF_BS.y && (bsm>NP_REF_BS.m || (bsm===NP_REF_BS.m && bsd>=NP_REF_BS.d)))){
    let days=0;
    for(let y=NP_REF_BS.y;y<bsy;y++) days+=NP_DATA[y].reduce((a,b)=>a+b,0);
    for(let m=1;m<bsm;m++) days+=NP_DATA[bsy][m-1];
    days+=bsd-NP_REF_BS.d;
    return days;
  } else {
    let days=0;
    for(let y=bsy;y<NP_REF_BS.y;y++) days-=NP_DATA[y].reduce((a,b)=>a+b,0);
    for(let m=bsm;m<NP_REF_BS.m;m++) days-=NP_DATA[bsy][m-1];
    days+=bsd-NP_REF_BS.d;
    return days;
  }
}
function adToBs(adDate){
  const days=Math.round((adDate-NP_REF_AD)/86400000);
  let y=NP_REF_BS.y,m=NP_REF_BS.m,d=NP_REF_BS.d+days;
  while(d<1){m--;if(m<1){y--;m=12;}d+=NP_DATA[y][m-1];}
  while(true){const md=NP_DATA[y][m-1];if(d>md){d-=md;m++;if(m>12){m=1;y++;}}else break;}
  return {y,m,d};
}
function bsToAd(bsy,bsm,bsd){
  const days=bsToAdDays(bsy,bsm,bsd);
  return new Date(NP_REF_AD.getTime()+days*86400000);
}
function getWeekday(bsy,bsm,bsd){return bsToAd(bsy,bsm,bsd).getDay();}
function todayBS(){return adToBs(new Date());}
function parseNpValue(s){
  if(!s) return null;
  s=String(s).replace(/[०-९]/g,d=>String(NED.indexOf(d)));
  const m=s.match(/(\d+)[\/\-](\d+)[\/\-](\d+)/);
  if(!m) return null;
  return {y:+m[1],m:+m[2],d:+m[3]};
}
function formatNpDate(y,m,d){return ne(String(y))+"/"+ne(String(m).padStart(2,'0'))+"/"+ne(String(d).padStart(2,'0'));}
function attachNpDatePicker(el){
  if(!el) return;
  el.readOnly=true;
  el.style.cursor='pointer';
  el.addEventListener('click',e=>{e.stopPropagation();openNpPicker(el);});
}
function closeAllNpPickers(){
  document.querySelectorAll('.np-picker-popup').forEach(x=>x.remove());
  document.removeEventListener('click',onDocClickPicker);
}
function onDocClickPicker(e){
  if(e.target.closest('.np-picker-popup')) return;
  if(e.target.classList && e.target.classList.contains('np-date-input')) return;
  closeAllNpPickers();
}
function openNpPicker(inputEl){
  closeAllNpPickers();
  const cur=parseNpValue(inputEl.value)||todayBS();
  const popup=document.createElement('div');
  popup.className='np-picker-popup';
  document.body.appendChild(popup);
  const rect=inputEl.getBoundingClientRect();
  let left=rect.left, top=rect.bottom+4;
  if(left+290>window.innerWidth) left=window.innerWidth-300;
  if(top+300>window.innerHeight) top=rect.top-300;
  popup.style.left=Math.max(6,left)+'px';
  popup.style.top=Math.max(6,top)+'px';

  let viewY=cur.y, viewM=cur.m;
  const minY=Math.min(...Object.keys(NP_DATA).map(Number));
  const maxY=Math.max(...Object.keys(NP_DATA).map(Number));

  function render(){
    const yearsOpts=[];
    for(let y=minY;y<=maxY;y++) yearsOpts.push('<option value="'+y+'"'+(y===viewY?' selected':'')+'>'+ne(y)+'</option>');
    let html='<div class="np-picker-header">'+
      '<button type="button" data-d="py">«</button>'+
      '<select class="np-y-sel" style="flex:1">'+yearsOpts.join('')+'</select>'+
      '<button type="button" data-d="pm">‹</button>'+
      '<select class="np-m-sel" style="flex:1">'+NP_MONTHS.map((mn,i)=>'<option value="'+(i+1)+'"'+((i+1)===viewM?' selected':'')+'>'+mn+'</option>').join('')+'</select>'+
      '<button type="button" data-d="nm">›</button>'+
      '<button type="button" data-d="ny">»</button>'+
    '</div>';
    html+='<div class="np-picker-grid">';
    NP_DAYS_SHORT.forEach(d=>html+='<div class="np-picker-day head">'+d+'</div>');
    const firstWd=getWeekday(viewY,viewM,1);
    for(let i=0;i<firstWd;i++) html+='<div></div>';
    const dim=NP_DATA[viewY][viewM-1];
    const today=todayBS();
    for(let d=1;d<=dim;d++){
      const isT=(today.y===viewY&&today.m===viewM&&today.d===d);
      html+='<div class="np-picker-day'+(isT?' today':'')+'" data-day="'+d+'">'+ne(d)+'</div>';
    }
    html+='</div>';
    popup.innerHTML=html;
    popup.querySelectorAll('button').forEach(b=>{
      b.addEventListener('click',ev=>{
        ev.stopPropagation();
        const d=b.dataset.d;
        if(d==='py') viewY=Math.max(minY,viewY-1);
        else if(d==='ny') viewY=Math.min(maxY,viewY+1);
        else if(d==='pm'){viewM--; if(viewM<1){viewM=12; viewY=Math.max(minY,viewY-1);}}
        else if(d==='nm'){viewM++; if(viewM>12){viewM=1; viewY=Math.min(maxY,viewY+1);}}
        render();
      });
    });
    const ySel=popup.querySelector('.np-y-sel');
    const mSel=popup.querySelector('.np-m-sel');
    if(ySel) ySel.addEventListener('change',e=>{viewY=+e.target.value; render();});
    if(mSel) mSel.addEventListener('change',e=>{viewM=+e.target.value; render();});
    popup.querySelectorAll('.np-picker-day[data-day]').forEach(el=>{
      el.addEventListener('click',ev=>{
        ev.stopPropagation();
        const d=+el.dataset.day;
        inputEl.value=formatNpDate(viewY,viewM,d);
        closeAllNpPickers();
        inputEl.dispatchEvent(new Event('input'));
        inputEl.dispatchEvent(new Event('change'));
      });
    });
  }
  render();
  setTimeout(()=>document.addEventListener('click',onDocClickPicker),0);
}

