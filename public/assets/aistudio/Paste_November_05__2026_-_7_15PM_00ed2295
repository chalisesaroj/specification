let specColumns=['Criteria','Requirement'];
let specRows=[];
let specView='spec';
let pmRowIndex=-1;
let pmTemp={params:[], text:''};

function initSpec(){
  const sel=$('#specType');
  sel.innerHTML='<option value="">-- किसिम छान्नुहोस् --</option>'+
    Object.keys(SPEC_TEMPLATES).map(k=>'<option>'+esc(k)+'</option>').join('');
  specColumns=['Criteria','Requirement'];
  specRows=[{cells:['General',''],params:[],reqText:''}];
  $('#specDelivery').value='Office of the Municipal Executive, Pokhara Metropolitan City';
  renderSpecRows();specPreviewRender();
}
function onSpecTypeChange(){
  const t=$('#specType').value;
  if(t&&SPEC_TEMPLATES[t]) $('#specTitle').value=SPEC_TEMPLATES[t].title;
}
function loadSpecTemplate(){
  const t=$('#specType').value;
  if(!t){alert('कृपया किसिम छान्नुहोस्');return;}
  const tpl=SPEC_TEMPLATES[t];
  specColumns=['Criteria','Requirement'];
  specRows=tpl.rows.map(x=>({cells:[x[0],x[1]],params:[],reqText:''}));
  $('#specTitle').value=tpl.title;
  renderSpecRows();specPreviewRender();
}
function ensureRowWidth(r){
  while(r.cells.length<specColumns.length) r.cells.push('');
  if(r.cells.length>specColumns.length) r.cells.length=specColumns.length;
  if(!Array.isArray(r.params)) r.params=[];
  if(typeof r.reqText!=='string') r.reqText='';
}
function buildRequirementText(r, ci){
  const clauses=(r.params||[]).map(p=>{
    const parts=[];
    if(p.p) parts.push(p.p);
    if(p.op) parts.push(p.op);
    if(p.v) parts.push(p.v);
    if(p.u) parts.push(p.u);
    return parts.join(' ').trim();
  }).filter(Boolean);
  const paramText=clauses.join(', ');
  const freeText=(r.reqText||'').trim();
  if(paramText && freeText) return paramText+'. '+freeText;
  if(paramText) return paramText;
  if(freeText) return freeText;
  return r.cells[ci]||'';
}
function renderSpecRows(){
  specRows.forEach(ensureRowWidth);
  let h='<thead><tr><th style="width:36px;text-align:center">S.N</th>';
  specColumns.forEach((c,i)=>{
    h+='<th><input value="'+esc(c)+'" oninput="specColumns['+i+']=this.value;renderSpecRows();specPreviewRender()" style="font-size:11px;font-weight:600">';
    if(specColumns.length>1){
      h+='<button class="mini danger" style="margin-top:3px;width:100%;font-size:10px" onclick="removeSpecColumn('+i+')">यो स्तम्भ हटाउने</button>';
    }
    h+='</th>';
  });
