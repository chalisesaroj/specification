function estOfficeBlockHTML(){
  const parent=$('#e_parentOffice').value.trim();
  const office=$('#e_office').value.trim();
  const loc=$('#e_location').value.trim();
  if(!office && !parent && !loc) return '';
  let h='<div class="office-title">';
  if(parent) h+='<div class="parent">'+esc(parent)+'</div>';
  if(office) h+='<div class="child">'+esc(office)+'</div>';
  if(loc) h+='<div class="loc">'+esc(loc)+'</div>';
  h+='</div>';
  return h;
